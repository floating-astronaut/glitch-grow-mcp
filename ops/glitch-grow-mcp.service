[Unit]
Description=Glitch Grow MCP server (multi-tenant) — streamable-HTTP on :3106
After=network.target meta-ads-mcp.service amazon-ads-mcp.service
Wants=meta-ads-mcp.service amazon-ads-mcp.service

[Service]
Type=simple
User=support
Group=support
WorkingDirectory=/home/support/glitch-grow-mcp
EnvironmentFile=-/home/support/glitch-grow-mcp/.env
ExecStart=/home/support/glitch-grow-mcp/.venv/bin/glitch-grow-mcp serve
Restart=on-failure
RestartSec=3
StandardOutput=journal
StandardError=journal

# Light hardening
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=false
PrivateTmp=true

[Install]
WantedBy=multi-user.target
